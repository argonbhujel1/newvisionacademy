SECRET_KEY=change-this-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# Turso (libSQL) – Recommended for Vercel / production
# ─────────────────────────────────────────────────────────────
# 1. Create DB:   turso db create newvisionacademy
# 2. Get URL:     turso db show --url newvisionacademy
# 3. Create token: turso db tokens create newvisionacademy
#
# Example values:
# TURSO_DATABASE_URL=libsql://newvisionacademy-xxxxx.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Legacy Postgres / Neon (optional – only if not using Turso)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
